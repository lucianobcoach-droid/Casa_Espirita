DJANGO_DEBUG=0
DJANGO_SECRET_KEY=troque-por-uma-chave-segura
DJANGO_ALLOWED_HOSTS=seu-dominio.com,www.seu-dominio.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://seu-dominio.com,https://www.seu-dominio.com

# Banco atual da homologacao
DJANGO_DB_PATH=/caminho/persistente/db.sqlite3

# Static e media
DJANGO_MEDIA_ROOT=/caminho/persistente/media

# Cookies e HTTPS
DJANGO_SESSION_COOKIE_SECURE=1
DJANGO_CSRF_COOKIE_SECURE=1
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=1
DJANGO_SECURE_HSTS_PRELOAD=0
DJANGO_SECURE_PROXY_SSL_HEADER=1

# E-mail
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=smtp.seu-provedor.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=usuario@seudominio.com
DJANGO_EMAIL_HOST_PASSWORD=troque-por-senha-ou-token
DJANGO_EMAIL_USE_TLS=1
DJANGO_EMAIL_USE_SSL=0
DJANGO_DEFAULT_FROM_EMAIL=no-reply@seudominio.com
DJANGO_SERVER_EMAIL=no-reply@seudominio.com
